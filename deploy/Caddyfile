{
    email {$IGES_ACME_EMAIL}
}

{$IGES_DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
    }

    @restricted path /v1/admin/* /v1/cases* /v1/auth/* /workspace /publication /v1/public/publications* /v1/public/cases* /docs /redoc /openapi.json
    respond @restricted 404

    reverse_proxy api:8000
}
