# REQUIRED: choose distinct, high-entropy secrets; never commit filled .env
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_DISTINCT_LONG_RANDOM_PASSWORD
IGES_DB_PASSWORD=REPLACE_WITH_DISTINCT_LONG_RANDOM_PASSWORD
IGES_PUBLIC_PROJECT_ID=00000000-0000-4000-8000-000000000001
# Privileged endpoints remain inaccessible until the real IdP is configured.
IGES_OIDC_ISSUER=
IGES_OIDC_AUDIENCE=
IGES_OIDC_JWKS_URL=
IGES_OIDC_WEB_CLIENT_ID=iges-web
# Privileged users must provide signed MFA evidence and recent authentication.
IGES_OIDC_REQUIRE_MFA=true
IGES_OIDC_REQUIRED_ACR=
IGES_OIDC_MAX_AUTH_AGE=900
# Explicit controlled-environment operator gate; legal/privacy approval is still required per revision.
IGES_ENABLE_PUBLICATION=false
IGES_OCR_LANGUAGES=eng
# Optional direct market-data access only; no trading/account endpoints. Keep real keys private.
IGES_ALPACA_DATA_KEY=
IGES_ALPACA_DATA_SECRET=
