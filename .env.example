# REQUIRED: choose distinct, high-entropy secrets; never commit filled .env
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_DISTINCT_LONG_RANDOM_PASSWORD
IGES_DB_PASSWORD=REPLACE_WITH_DISTINCT_LONG_RANDOM_PASSWORD
IGES_PUBLIC_PROJECT_ID=00000000-0000-4000-8000-000000000001
# Optional: admin endpoints remain inaccessible until all three are set.
IGES_OIDC_ISSUER=
IGES_OIDC_AUDIENCE=
IGES_OIDC_JWKS_URL=

# Only for public TLS gateway deployment:
# IGES_DOMAIN=example.org
# IGES_ACME_EMAIL=operator@example.org
