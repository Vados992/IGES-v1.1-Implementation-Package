FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/iges
RUN apt-get update && apt-get install -y --no-install-recommends \
    poppler-utils tesseract-ocr tesseract-ocr-eng tesseract-ocr-rus tesseract-ocr-ukr \
    tesseract-ocr-spa tesseract-ocr-por && rm -rf /var/lib/apt/lists/* \
    && groupadd --system iges && useradd --system --gid iges iges
COPY requirements.txt /opt/iges/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY app /opt/iges/app
COPY db/migrations /opt/iges/db/migrations
USER iges
CMD ["python","-m","app.process_documents"]
